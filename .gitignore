# --- DVC: кэш и локальный remote (сами блобы не в Git) ---
.dvc/cache/
.dvc/tmp/
.dvc/dvc_storage/
dvc_storage/

# --- Данные: сырые файлы не в Git; метаданные DVC — *.dvc в data/ коммитим ---
